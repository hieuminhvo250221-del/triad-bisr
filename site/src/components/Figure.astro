---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}
const { src, alt, caption, width, height } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = src.startsWith("/") ? base + src : src;
---
<figure class="figure">
  <img src={href} alt={alt} width={width} height={height} decoding="sync" />
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>
